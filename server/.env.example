# Copy to .env for local dev (never commit .env — it's gitignored).
# In production, every value here is set with `fly secrets set KEY=value`.

NODE_ENV=development
PORT=8080

# Postgres — Fly Postgres internal URL or Neon connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bootsalebuddy

# 32+ random bytes: openssl rand -base64 48
JWT_SECRET=

# Anthropic — vision identification for /v1/scan.
ANTHROPIC_API_KEY=
# Cheapest vision-capable model; validated against server/fixtures before ship.
ANTHROPIC_MODEL=claude-haiku-4-5

# eBay Browse API (client-credentials OAuth, marketplace EBAY_GB).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# The Authorization header value configured in the RevenueCat webhook settings.
REVENUECAT_WEBHOOK_AUTH=

# Optional in dev.
SENTRY_DSN=
