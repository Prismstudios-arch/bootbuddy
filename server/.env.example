# Copy to .env for local dev (never commit .env — it's gitignored).
# In production, every value here is set with `fly secrets set KEY=value`.

NODE_ENV=development
PORT=8080

# Postgres — Fly Postgres internal URL or Neon connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bootsalebuddy

# 32+ random bytes: openssl rand -base64 48
JWT_SECRET=

# Vision identification for /v1/scan.
# gemini (default) = Google AI Studio free tier; anthropic = claude-haiku-4-5.
VISION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Price ANY category (not just records) by having Gemini search the live web
# and keeping only answers it can cite. Set to 1 to enable.
#
# Read services/web-prices.ts before turning this on. It is asking-price
# data, never sold, and it roughly doubles the upstream calls per scan.
# Turning it on also makes the App Store description's "no live price source
# for other categories" wording wrong — see STORE.md.
GEMINI_WEB_PRICES=

# Discogs personal access token — prices records/CDs from completed sales.
# Free, instant, no approval: discogs.com/settings/developers
DISCOGS_TOKEN=

# eBay Browse API (client-credentials OAuth, marketplace EBAY_GB).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# The Authorization header value configured in the RevenueCat webhook settings.
REVENUECAT_WEBHOOK_AUTH=

# Optional in dev.
SENTRY_DSN=
