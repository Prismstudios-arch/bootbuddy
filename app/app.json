{
  "expo": {
    "name": "Boot Sale Buddy",
    "slug": "boot-sale-buddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bootsalebuddy",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#121110",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bootsalebuddy.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Boot Sale Buddy uses the camera to identify items and estimate their resale value. Photos are processed and then discarded — never stored on our servers.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.bootsalebuddy.app",
      "adaptiveIcon": {
        "backgroundColor": "#121110",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121110",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Boot Sale Buddy uses the camera to identify items and estimate their resale value."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "primaryColor": "#E8B14E",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d0b139a-a61a-47af-afda-8df2d33b8988"
      }
    },
    "owner": "jonnywilson"
  }
}
